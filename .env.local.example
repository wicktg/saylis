# Copy to .env.local and fill in real values. Never commit .env.local.

# Optional: get a project ID at https://cloud.walletconnect.com to enable
# WalletConnect (QR-code) wallet connections. Without it, the app still
# works via injected wallets (MetaMask, etc.) — WalletConnect is simply
# omitted from the connector list.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=e7f1b56a3d85bf32a3c5a4e019162785

# Optional: override the default public Arbitrum Sepolia RPC endpoint.
NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Supabase — off-chain data layer (tokens table). Safe to expose client-side;
# access is governed by RLS policies on the table, not by keeping this secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Pinata — IPFS pinning for token images. SERVER-SIDE ONLY (no NEXT_PUBLIC_
# prefix) — used only inside app/api/upload-image, never sent to the browser.
PINATA_JWT=

# ---------------------------------------------------------------------
# X (Twitter) account linking — profile dropdown "Connect X"
# ---------------------------------------------------------------------
# Bio-code verification, not OAuth: the user pastes a generated code into
# their X bio, and we check for it via twitterapi.io's read-only public
# profile lookup (https://docs.twitterapi.io). No password, no X developer
# app, no OAuth consent screen. Get a key at https://twitterapi.io.
# SERVER-SIDE ONLY.
TWITTERAPI_IO_API_KEY=

# Supabase service-role key (Project Settings -> API -> service_role).
# SERVER-ONLY, never prefix with NEXT_PUBLIC_. Needed because x_accounts /
# x_verification_attempts / every infofi_* table have no public write
# policy — those writes are permanent or payout-affecting, so only server
# code that has already done its checks may perform them.
#
# PASTE THIS AS ONE UNBROKEN LINE. It is a JWT (three dot-separated parts)
# and is long enough that editors and terminals like to wrap it. A key whose
# signature has been split across lines fails with a 401 "Invalid API key"
# on every server write, which surfaces as silent-looking failures rather
# than an obvious error. Sanity check: the part after the LAST dot should be
# 43 characters.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# InfoFi daily mindshare recompute
# ---------------------------------------------------------------------
# Bearer token guarding POST /api/infofi/cron/recompute. That route calls a
# metered third-party API once per campaign participant, so it fails CLOSED
# when this is unset rather than becoming a public endpoint anyone can spend
# your twitterapi.io credits through. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# SERVER-SIDE ONLY.
CRON_SECRET=

# Signer for POST /api/infofi/cron/poke, which calls recordMarketCap() to
# advance a token's sustained-market-cap timer. Without this, no token can
# EVER become eligible — the contract has no way to watch price on its own.
#
# Assumed hot: it lives on a server and pays gas. That is acceptable because
# recordMarketCap is permissionless and non-custodial — it can only advance
# or reset a timer that anybody could advance themselves.
#
# This is NOT the team key. It cannot open a campaign or publish a payout
# root; those stay manual transactions from the multisig, so a compromised
# server cannot redirect anyone's tokens. SERVER-SIDE ONLY.
INFOFI_POKER_PRIVATE_KEY=

# There is no INFOFI_TEAM_PRIVATE_KEY, and there should never be one.
# openCampaign/publishResults decide real payouts — the admin dashboard's
# Approve & Open action has the team's CONNECTED wallet sign that
# transaction directly in the browser (see app/admin/page.tsx), so the
# key never needs to exist in server env at all.
