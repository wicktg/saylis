# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Deployer key — pays gas and signs the deployment tx only.
# It never receives any tokens and has no admin power over the deployed
# contract (there is no admin power to have — see ImmutableLaunchToken.sol).
PRIVATE_KEY=0xyourprivatekeyhere

# The bonding-curve contract that receives 100% of the token's fixed supply.
BONDING_CURVE_ADDRESS=0x0000000000000000000000000000000000dEaD

# Token parameters for this deployment.
TOKEN_NAME="Loxley Doge"
TOKEN_SYMBOL=LDOGE
TOKEN_DECIMALS=18
# Whole-token amount; the deploy script scales this by 10**TOKEN_DECIMALS.
TOKEN_TOTAL_SUPPLY=1000000000

# BondingCurve virtual-liquidity parameters (whole ETH / whole tokens).
VIRTUAL_ETH_RESERVE=30
VIRTUAL_TOKEN_RESERVE=1073000000

# Token creator — receives the escalating 75%-85% share of the 1% trade fee.
CREATOR_ADDRESS=0xyourcreatoraddresshere

# Already-deployed ProtocolTreasury address (deploy once via
# DeployProtocolTreasury.s.sol, then reuse for every curve).
PROTOCOL_TREASURY_ADDRESS=0xyourtreasuryaddresshere

# Owner (multisig) for a fresh ProtocolTreasury deployment. Only needed when
# running DeployProtocolTreasury.s.sol.
TREASURY_OWNER_ADDRESS=0xyourmultisigaddresshere

# USD price of 1 ETH, whole dollars. Used ONCE at curve construction to
# convert the fixed $10,000,000 volume cap into a wei threshold — not a
# live oracle, see BondingCurve.sol's NatSpec for why.
ETH_USD_PRICE=3000

# Number of blocks after deployment during which buy() is blocked
# (anti-snipe). 1 blocks same-block/next-block sniping without adding much
# delay for legitimate early buyers.
DELAY_BLOCKS=1

# Real-ETH-raised level (in wei) at which this curve graduates and halts
# trading, in preparation for a future DEX-migration step. 4.2 ETH =
# 4200000000000000000 wei.
GRADUATION_THRESHOLD_WEI=4200000000000000000

# Already-deployed GraduationMigrator address (deploy once via
# DeployGraduationMigrator.s.sol, then reuse for every curve) — the only
# address ever authorized to pull a graduated curve's real ETH reserve +
# reserved liquidity tokens.
GRADUATION_MIGRATOR_ADDRESS=0xyourmigratoraddresshere

# Additional creator-only tax on `sell` proceeds, in basis points
# (0-300, i.e. 0%-3%), applied only to whale sells — see
# BondingCurve.sol's "SELL TAX" NatSpec. `buy` is never subject to this.
# 0 disables it entirely.
SELL_TAX_BPS=0

# Chainlink-style ETH/USD price feed used ONLY to gate the whale sell tax
# live. Required even when SELL_TAX_BPS=0 (any non-zero address works in
# that case — it's never read when the rate is zero). This is Arbitrum
# Sepolia's real ETH/USD feed (verified on-chain: description() ==
# "ETH/USD", decimals() == 8) — note it may read as stale under
# BondingCurve's 1-hour staleness window, since testnet feeds are
# updated far less often than mainnet ones; the contract is designed to
# degrade gracefully (fall back to the most lenient tax tier) rather than
# block sells when that happens.
ETH_USD_PRICE_FEED_ADDRESS=0x2d3bBa5e0A9Fd8EAa45Dcf71A2389b7C12005b1f

# Only needed when running DeployGraduationMigrator.s.sol. These are
# Arbitrum Sepolia's official Uniswap V3 testnet deployment addresses (per
# developers.uniswap.org/contracts/v3/reference/deployments/arbitrum-deployments) —
# verify against that page before broadcasting, and swap in mainnet's
# addresses instead if deploying to Arbitrum One.
UNISWAP_V3_FACTORY_ADDRESS=0x248AB79Bbb9bC29bB72f7Cd42F17e054Fc40188e
UNISWAP_V3_POSITION_MANAGER_ADDRESS=0x6b2937Bde17889EDCf8fbD8dE31C3C2a70Bc4d65
WETH9_ADDRESS=0x980B62Da83eFf3D4576C647993b0c1D7faf17c73
UNISWAP_V3_POOL_FEE=3000

# Uniswap SwapRouter02. Each graduated token gets its own TokenFeeCollector,
# which uses this router to convert collected post-graduation sell tax into
# ETH before splitting it between creator and protocol treasury.
# Arbitrum Sepolia:
UNISWAP_SWAP_ROUTER_ADDRESS=0x101F443B4d1b059569D643917553c771E1b9663E

# Arbitrum Sepolia RPC endpoint (chain id 421614). Robinhood Chain, being an
# Arbitrum Orbit L2, is chain-identical — point this at its RPC instead to
# deploy the exact same artifact there. Also used by
# test/GraduationMigrator.t.sol to fork-test against Arbitrum Sepolia's
# real Uniswap V3 testnet deployment.
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Only required for `forge script ... --verify`.
ARBISCAN_API_KEY=
